# Copy to .env.local (never commit .env.local) and fill in the values.
# Everything below except NEXT_PUBLIC_SITE_URL is read server-side only, by app/api/contact/route.ts.

# Public URL of the site (used in metadata and in the contact email footer).
NEXT_PUBLIC_SITE_URL=https://uexora.com

# --- Contact form: outgoing SMTP ------------------------------------------------
# Recipient inboxes (hello@ / education@ / studio@) live in lib/site.ts, not here.
#
# Google Workspace:  SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
#                    SMTP_USER=the mailbox address, SMTP_PASS=an App Password
#                    (Google Account > Security > 2-Step Verification > App passwords;
#                    plain account passwords are rejected). MAIL_FROM must be that
#                    mailbox or an alias it is allowed to send as.
# Zoho Mail:         SMTP_HOST=smtp.zoho.com (smtp.zoho.in for India-hosted accounts),
#                    SMTP_PORT=465 with SMTP_SECURE=true, or 587 with SMTP_SECURE=false.
#                    SMTP_USER=the mailbox address, SMTP_PASS=an app-specific password
#                    when two-factor auth is on. MAIL_FROM must match SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true = implicit TLS (port 465). false = STARTTLS (port 587). Defaults to true only when SMTP_PORT is 465.
SMTP_SECURE=false
SMTP_USER=hello@uexora.com
SMTP_PASS=replace-with-app-password
# The address the enquiry is sent from. The visitor's address goes in Reply-To.
MAIL_FROM=hello@uexora.com

# --- Content studio (Sanity) ----------------------------------------------------
# Leave NEXT_PUBLIC_SANITY_PROJECT_ID empty to run the site from the files in content/.
# Create a free project at https://www.sanity.io/manage (or `npx sanity init` in this folder),
# copy its project id here, then run `npm run cms:seed` once to load the current copy.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Write token (Editor role): sanity.io/manage > API > Tokens. Used by the seed scripts AND by the
# contact form to save enquiries in the studio, so set it on the host (e.g. Vercel) as well.
# Server-only: never prefix it with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=
# Random string shared with the publish webhook (sanity.io/manage > API > Webhooks > /api/revalidate).
SANITY_REVALIDATE_SECRET=
# Only needed if the dataset is made private (paid plans): a Viewer token for the site's reads.
SANITY_API_READ_TOKEN=
